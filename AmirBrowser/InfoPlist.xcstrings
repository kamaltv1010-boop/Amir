    "NSCameraUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تطلب المواقع استخدام الكاميرا، مثلاً لالتقاط صورة ورفعها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites can ask to use the camera, for example to take a photo to upload."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web peuvent demander à utiliser l’appareil photo, par exemple pour prendre une photo à envoyer."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تطلب المواقع استخدام الميكروفون، مثلاً لتسجيل فيديو أو رسالة صوتية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites can ask to use the microphone, for example to record a video or a voice message."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sites web peuvent demander à utiliser le micro, par exemple pour enregistrer une vidéo ou un message vocal."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك حفظ الصور من المواقع في مكتبة الصور."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets you save images from websites to your photo library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet d’enregistrer des images des sites web dans votre photothèque."
          }
        }
      }
    }

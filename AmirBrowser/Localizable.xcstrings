    "Pages you open in private tabs aren't saved in your history, and their cookies and website data are deleted when you close the last private tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحفظ الصفحات التي تفتحها في علامات التبويب الخاصة في سجلك، وتُحذف ملفات تعريف الارتباط وبيانات المواقع عند إغلاق آخر علامة تبويب خاصة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages you open in private tabs aren't saved in your history, and their cookies and website data are deleted when you close the last private tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages ouvertes dans des onglets privés ne sont pas enregistrées dans l’historique, et leurs cookies et données de sites sont supprimés quand vous fermez le dernier onglet privé."
          }
        }
      }
    },

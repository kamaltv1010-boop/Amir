    "This deletes cookies, website data and history, closes all tabs and changes every fingerprint. Bookmarks and pinned links are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف ملفات تعريف الارتباط وبيانات المواقع والسجل، وإغلاق كل علامات التبويب، وتغيير كل البصمات. تبقى المفضلة والروابط المثبتة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes cookies, website data and history, closes all tabs and changes every fingerprint. Bookmarks and pinned links are kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les cookies, les données des sites et l’historique, ferme tous les onglets et change toutes les empreintes. Les signets et les liens épinglés sont conservés."
          }
        }
      }
    },
    "This extension couldn't be loaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل هذا الامتداد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This extension couldn't be loaded."

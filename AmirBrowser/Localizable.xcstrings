        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger cette extension."
          }
        }
      }
    },
    "This file isn't a web extension. Choose a .zip or .crx file, or a folder with a manifest.json file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الملف ليس امتداد ويب. اختر ملف ‎.zip أو ‎.crx، أو مجلداً فيه ملف manifest.json."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file isn't a web extension. Choose a .zip or .crx file, or a folder with a manifest.json file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas une extension web. Choisissez un fichier .zip ou .crx, ou un dossier contenant un fichier manifest.json."
          }
        }
      }
    },
    "This site checks the browser closely when you sign in or create an account, so it sees this iPhone as it is: no fingerprint noise and no other phone's user agent. Trackers are still blocked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفحص هذا الموقع المتصفح بدقة عند تسجيل الدخول أو إنشاء حساب، لذلك يرى هذا الـ iPhone كما هو: بدون تشويش البصمة وبدون User Agent هاتف آخر. وتبقى أدوات التتبع محظورة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This site checks the browser closely when you sign in or create an account, so it sees this iPhone as it is: no fingerprint noise and no other phone's user agent. Trackers are still blocked."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce site vérifie de près le navigateur quand vous vous connectez ou créez un compte, il voit donc cet iPhone tel qu’il est : sans bruit d’empreinte ni User-Agent d’un autre téléphone. Les traqueurs restent bloqués."
          }
        }
      }
    },

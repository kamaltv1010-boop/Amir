    "Tap ⋯ then “Add Bookmark” to save the current page." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على ⋯ ثم «إضافة إلى المفضلة» لحفظ الصفحة الحالية."
          }
        },
        "en" : {
          "stringUnit" : {

      }
    },
    "This deletes cookies and website data, closes open pages and changes every fingerprint. Bookmarks and pinned links are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف ملفات تعريف الارتباط وبيانات المواقع، وإغلاق الصفحات المفتوحة، وتغيير كل البصمات. تبقى المفضلة والروابط المثبتة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes cookies and website data, closes open pages and changes every fingerprint. Bookmarks and pinned links are kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les cookies et les données des sites, ferme les pages ouvertes et change toutes les empreintes. Les signets et les liens épinglés sont conservés."
          }
        }
      }
    },
